{
  "name": "test",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:toggle": "jest --testNamePattern=\"Toggle Status\"",
    "user": "node users.js",
    "admin": "node seedAdmin.js",
    "orders": "node seedOrders.js",
    "builders": "node seedBuilders.js",
    "messages": "node seedMessages.js",
    "hours": "node testOperatingHours.js",
    "hours:weekly": "node runHoursTests.js weekly",
    "hours:special": "node runHoursTests.js special",
    "hours:status": "node runHoursTests.js status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.8.4",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.6.0",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.24.7",
    "@reduxjs/toolkit": "^2.6.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "babel-jest": "^29.7.0",
    "express": "^5.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mongoose": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.4.1",
    "react-router-dom": "^6.26.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "^../client/src/(.*)$": "<rootDir>/__mocks__/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@babel|supertest|superagent)/)"
    ],
    "testMatch": [
      "**/__tests__/**/*.(js|jsx)",
      "**/*.(test|spec).(js|jsx)"
    ]
  }
}
